{
  "name": "restclient",
  "displayName": "REST Client",
  "description": "Postman-compatible REST client for VS Code. Runs real Postman collections, environments and pm.* scripts locally, with no account.",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "publisher": "davidvogel94",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=18"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Testing",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pre-request and test scripts from collections are not executed in an untrusted workspace."
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test:unit": "npm run build && npm run compile:test && node --test \"out/test/unit/*.test.js\"",
    "spike": "node scripts/spike.mjs",
    "package": "vsce package --no-yarn --allow-missing-repository --skip-license -o restclient-0.0.1.vsix",
    "compile:test": "tsc --outDir out",
    "test:integration": "npm run build && npm run compile:test && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "ship-check": "npm run package && npm run compile:test && node scripts/ship-check.cjs restclient-0.0.1.vsix"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "postman-collection": "5.3.1",
    "postman-collection-transformer": "4.1.14",
    "postman-runtime": "7.56.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.5",
    "highlight.js": "^11.12.0",
    "svelte": "^5.56.9",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "restclient",
          "title": "REST Client",
          "icon": "resources/activity-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "restclient-console",
          "title": "Postman Console",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "restclient": [
        {
          "id": "restclient.collections",
          "name": "Collections",
          "icon": "resources/activity-icon.svg"
        },
        {
          "id": "restclient.environments",
          "name": "Environments",
          "icon": "resources/activity-icon.svg"
        },
        {
          "id": "restclient.cookies",
          "name": "Cookies",
          "icon": "resources/activity-icon.svg"
        }
      ],
      "restclient-console": [
        {
          "id": "restclient.console",
          "name": "Postman Console",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "restclient.collections",
        "contents": "No Postman collections found in this workspace.\n\nThe workspace is scanned for `*.postman_collection.json` and anything it finds is worked on in place. Create one, or import an export from elsewhere — it is copied in.\n\n[New Collection](command:restclient.newCollection)\n[Import Collection](command:restclient.importCollection)\n\nCollections that live outside this folder are picked up once you add their folder to the workspace.\n[Add Folder to Workspace](command:workbench.action.addRootFolder)\n[Configure Discovery](command:restclient.openSettings)",
        "when": "restclient:hasWorkspace && !restclient:hasCollections && restclient:autoDiscover"
      },
      {
        "view": "restclient.collections",
        "contents": "No Postman collections in this workspace yet.\n\nThe workspace scan is off, so only the files named in `restclient.collections` are used.\n\n[New Collection](command:restclient.newCollection)\n[Import Collection](command:restclient.importCollection)\n[Turn On Discovery](command:restclient.openSettings)",
        "when": "restclient:hasWorkspace && !restclient:hasCollections && !restclient:autoDiscover"
      },
      {
        "view": "restclient.collections",
        "contents": "REST Client works on the folders you have open, and there are none.\n\nOpen the folder your collections are in — or any folder, then add theirs to it. Requests can only read files from a folder in the workspace, which is why one has to be open.\n\n[Open Folder](command:workbench.action.files.openFileFolder)",
        "when": "!restclient:hasWorkspace && isMac && !remoteName"
      },
      {
        "view": "restclient.collections",
        "contents": "REST Client works on the folders you have open, and there are none.\n\nOpen the folder your collections are in — or any folder, then add theirs to it. Requests can only read files from a folder in the workspace, which is why one has to be open.\n\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "!restclient:hasWorkspace && !(isMac && !remoteName)"
      },
      {
        "view": "restclient.environments",
        "contents": "No environments found in this workspace.\n\nAn environment supplies the `{{variables}}` a request resolves against. The workspace is scanned for `*.postman_environment.json`; create an empty one, or import an export — it is copied in.\n\n[New Environment](command:restclient.newEnvironment)\n[Import Environment](command:restclient.importEnvironment)\n[Configure Discovery](command:restclient.openSettings)",
        "when": "restclient:hasWorkspace && !restclient:hasEnvironments && restclient:autoDiscover"
      },
      {
        "view": "restclient.environments",
        "contents": "No environments in this workspace yet.\n\nAn environment supplies the `{{variables}}` a request resolves against. The workspace scan is off, so only the files named in `restclient.environments` are used.\n\n[New Environment](command:restclient.newEnvironment)\n[Import Environment](command:restclient.importEnvironment)\n[Turn On Discovery](command:restclient.openSettings)",
        "when": "restclient:hasWorkspace && !restclient:hasEnvironments && !restclient:autoDiscover"
      },
      {
        "view": "restclient.cookies",
        "contents": "No cookies stored yet.\n\nCookies a response sets are kept here and sent on the next request — in the extension's global storage, never in your workspace. You can also add one by hand.\n\n[Manage Cookies](command:restclient.manageCookies)"
      }
    ],
