        },
        {
          "command": "restclient.newFolder",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)(Expanded|Collapsed)?(Running)?$/",
          "group": "1_new@2"
        },
        {
          "command": "restclient.openCollectionFile",
          "when": "view == restclient.collections && viewItem =~ /^collection(Expanded|Collapsed|Broken|Unsupported)?(Running)?$/",
          "group": "inline@3"
        },
        {
          "command": "restclient.expandRow",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)Collapsed(Running)?$/",
          "group": "inline@4"
        },
        {
          "command": "restclient.collapseRow",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)Expanded(Running)?$/",
          "group": "inline@4"
        },
        {
          "command": "restclient.openCollectionFile",
          "when": "view == restclient.collections && viewItem =~ /^collection(Expanded|Collapsed|Broken|Unsupported)?(Running)?$/",
          "group": "1_open@1"
        },
        {
          "command": "restclient.exportCollection",
          "when": "view == restclient.collections && viewItem =~ /^collection(Expanded|Collapsed)?(Running)?$/",
          "group": "1_open@2"
        },
        {
          "command": "restclient.rename",
          "when": "view == restclient.collections && viewItem =~ /^(request|folder)(Expanded|Collapsed)?(Running)?$/",
          "group": "2_edit@1"
        },
        {
          "command": "restclient.duplicate",
          "when": "view == restclient.collections && viewItem =~ /^(request|folder)(Expanded|Collapsed)?(Running)?$/",
          "group": "2_edit@2"
        },
        {
          "command": "restclient.delete",
          "when": "view == restclient.collections && viewItem =~ /^(request|folder)(Expanded|Collapsed)?(Running)?$/",
          "group": "3_destructive@1"
        },
        {
          "command": "restclient.removeFromWorkspace",
          "when": "view == restclient.collections && viewItem =~ /^collection(Expanded|Collapsed|Broken|Unsupported|Missing)?(Running)?$/",
          "group": "9_remove"
        },
        {
          "command": "restclient.setActiveEnvironment",
          "when": "view == restclient.environments && viewItem == environment",
          "group": "inline@1"
        },
        {
          "command": "restclient.clearActiveEnvironment",
          "when": "view == restclient.environments && viewItem == environmentActive",
          "group": "inline@1"
        },
        {
          "command": "restclient.addVariable",
          "when": "view == restclient.environments && viewItem =~ /^environment(Active)?$/",
          "group": "inline@2"
        },
        {
          "command": "restclient.editEnvironment",
          "when": "view == restclient.environments && viewItem =~ /^environment(Active)?$/",
          "group": "inline@3"
        },
        {
          "command": "restclient.setActiveEnvironment",
          "when": "view == restclient.environments && viewItem == environment",
          "group": "0_active@1"
        },
        {
          "command": "restclient.clearActiveEnvironment",
          "when": "view == restclient.environments && viewItem == environmentActive",
          "group": "0_active@1"
        },
        {
          "command": "restclient.openEnvironmentFile",
          "when": "view == restclient.environments && viewItem =~ /^environment(Active|Broken|Unsupported)?$/",
          "group": "1_open@1"
        },
        {
          "command": "restclient.exportEnvironment",
          "when": "view == restclient.environments && viewItem =~ /^environment(Active)?$/",
          "group": "1_open@2"
        },
        {
          "command": "restclient.removeEnvironment",
          "when": "view == restclient.environments && viewItem =~ /^environment(Active|Broken|Unsupported|Missing)?$/",
          "group": "9_remove@1"
        },
        {
          "command": "restclient.editVariable",
          "when": "view == restclient.environments && viewItem =~ /^variable/",
          "group": "inline@1"
        },
        {
          "command": "restclient.moveSecretToKeychain",
          "when": "view == restclient.environments && viewItem == variablePlaintextSecret",
          "group": "inline@2"
        },
        {
          "command": "restclient.deleteVariable",
          "when": "view == restclient.environments && viewItem =~ /^variable/",
          "group": "inline@3"
        },
        {
          "command": "restclient.toggleVariable",
          "when": "view == restclient.environments && viewItem =~ /^variable/",
          "group": "2_edit@1"
        },
        {
          "command": "restclient.toggleVariableSecret",
          "when": "view == restclient.environments && viewItem =~ /^variable/",
          "group": "2_edit@2"
        },
        {
          "command": "restclient.deleteCookieDomain",
          "when": "view == restclient.cookies && viewItem == cookieDomain",
          "group": "inline@1"
        },
        {
          "command": "restclient.editCookie",
          "when": "view == restclient.cookies && viewItem == cookie",
          "group": "inline@1"
        },
        {
          "command": "restclient.deleteCookie",
          "when": "view == restclient.cookies && viewItem == cookie",
          "group": "inline@2"
        },
        {
          "command": "restclient.deleteCookieDomain",
          "when": "view == restclient.cookies && viewItem == cookieDomain",
          "group": "3_destructive@1"
        },
        {
          "command": "restclient.editCookie",
          "when": "view == restclient.cookies && viewItem == cookie",
          "group": "2_edit@1"
        },
        {
          "command": "restclient.deleteCookie",
          "when": "view == restclient.cookies && viewItem == cookie",
          "group": "3_destructive@1"
        },
        {
          "command": "restclient.runAll",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)(Expanded|Collapsed)?$/",
          "group": "0_run@1"
        },
        {
          "command": "restclient.stopRun",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)(Expanded|Collapsed)?Running$/",
          "group": "0_run@1"
        },
        {
          "command": "restclient.openOverview",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)(Expanded|Collapsed)?(Running)?$/",
          "group": "0_run@2"
        },
        {
          "command": "restclient.convertCollection",
          "when": "view == restclient.collections && viewItem == collectionUnsupported",
          "group": "inline@0"
        },
        {
          "command": "restclient.convertCollection",
          "when": "view == restclient.collections && viewItem == collectionUnsupported",
          "group": "1_open@1"
        }
      ],
      "explorer/context": [
        {
          "command": "restclient.importCollection",
          "when": "resourceFilename =~ /postman_collection\\.json$/",
          "group": "7_modification"
        },
        {
          "command": "restclient.importEnvironment",
          "when": "resourceFilename =~ /postman_(environment|globals)\\.json$/",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "REST Client",
      "properties": {
        "restclient.collections": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "Postman collection files this workspace works on, named explicitly and edited in place. Paths are relative to the workspace folder; absolute and `~/`-prefixed paths are also accepted. Files the workspace scan finds are worked on too and are *not* listed here — see `#restclient.autoDiscover#`. Relative paths are relative to the folder whose settings name them; in a multi-root workspace every folder's list is used, not just the first one's.",
          "items": {
            "type": "string"
          }
        },
        "restclient.environments": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "Postman environment files this workspace works on, named explicitly and edited in place. Paths are relative to the workspace folder; absolute and `~/`-prefixed paths are also accepted. Files the workspace scan finds are worked on too and are *not* listed here — see `#restclient.autoDiscover#`. Relative paths are relative to the folder whose settings name them; in a multi-root workspace every folder's list is used, not just the first one's.",
          "items": {
            "type": "string"
          }
        },
        "restclient.autoDiscover": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Work on Postman collections and environments found in the workspace, without listing them. Discovered files are never written to `#restclient.collections#` or `#restclient.environments#` — those stay the explicit list, for files with unconventional names or outside the workspace. Turn this off to work only on what they name. Set per folder: in a multi-root workspace each folder decides for itself, so a repo that opts out does not stop a folder you added purely to hold collections from being scanned."
        },
        "restclient.discoverPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.postman_collection.json",
            "**/*.postman_environment.json",
            "**/*.postman_globals.json"
          ],
          "scope": "resource",
          "markdownDescription": "Glob patterns the workspace scan looks for, relative to the workspace folder. Whether a match is a collection or an environment is read from the file, not from its name. All `.json` files under `#restclient.importLocation#` are scanned as well, without being listed here. `#files.exclude#` and `#search.exclude#` are honoured on top of these. Read per folder in a multi-root workspace, so each folder can be named its own way."
        },
        "restclient.discoverExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Paths and glob patterns the workspace scan skips. *Stop Working on This Collection* records its answer here, since a file nobody listed cannot be removed from a list. Delete an entry to have the scan pick the file up again. A file named in `#restclient.collections#` is unaffected — saying so explicitly outranks this."
        },
        "restclient.importLocation": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Folder that imported collections and environments are copied into, relative to the workspace folder. Empty means the next import asks, and remembers the answer here. A file already inside the workspace is worked on where it is and never copied. Every `.json` file under this folder is scanned whatever it is named, on top of `#restclient.discoverPatterns#` — anything that is not a Postman export is ignored. Read per folder in a multi-root workspace; the first folder that names one is where imports land."
        },
        "restclient.followRedirects": {
          "type": "boolean",
          "default": true,
          "description": "Automatically follow HTTP redirects."
        },
        "restclient.strictSSL": {
          "type": "boolean",
          "default": false,
          "description": "Verify TLS certificates. Postman leaves this off by default; when unset, VS Code's own http.proxyStrictSSL is not consulted and verification stays off."
        },
        "restclient.requestTimeoutMs": {
          "type": "number",
          "default": 0,
          "description": "Milliseconds before a request times out. 0 means no timeout."
        },
        "restclient.scriptTimeoutMs": {
          "type": "number",
          "default": 60000,
          "description": "Milliseconds a pre-request or test script may run before it is terminated."
        },
        "restclient.maxResponseSizeMb": {
          "type": "number",
          "default": 5,
          "description": "Largest response body kept in memory and shown in the response pane, in megabytes."
        },
        "restclient.maxRedirects": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of redirects to follow."
        },
        "restclient.protocolVersion": {
          "type": "string",
          "enum": [
            "auto",
            "http1",
            "http2"
          ],
          "default": "auto",
          "description": "HTTP protocol version to negotiate."
        },
        "restclient.certificates": {
          "type": "array",
          "default": [],
          "markdownDescription": "Client certificates. Paths are resolved inside the workspace folder.",
          "items": {
            "type": "object",
            "required": [
              "matches"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Label shown in logs."
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "URL match patterns, e.g. `https://api.example.com/*`."
              },
              "key": {
                "type": "string",
                "description": "Path to the private key (PEM)."
              },
              "cert": {
                "type": "string",
                "description": "Path to the certificate (PEM)."
              },
              "pfx": {
                "type": "string",
                "description": "Path to a PFX/P12 bundle, instead of key + cert."
              },
              "passphrase": {
                "type": "string",
                "description": "Passphrase for the key or PFX."
              }
            }
          }
        },
        "restclient.proxies": {
          "type": "array",
          "default": [],
          "markdownDescription": "Proxy servers. When empty, VS Code's `#http.proxy#` setting is used instead.",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "match": {
                "type": "string",
                "default": "http+https://*/*",
                "description": "Which requests this proxy applies to."
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number",
                "default": 8080
              },
              "tunnel": {
                "type": "boolean",
                "default": false,
                "description": "Use CONNECT tunnelling."
              },
              "disabled": {
                "type": "boolean",
                "default": false
              },
              "username": {
                "type": "string"
              },
              "password": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
