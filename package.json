      "view/item/context": [
        {
          "command": "restclient.runRequest",
          "when": "view == restclient.collections && viewItem == request",
          "group": "inline@1"
        },
        {
          "command": "restclient.stopRun",
          "when": "view == restclient.collections && viewItem == requestRunning",
          "group": "inline@1"
        },
        {
          "command": "restclient.runRequest",
          "when": "view == restclient.collections && viewItem == request",
          "group": "0_run@1"
        },
        {
          "command": "restclient.stopRun",
          "when": "view == restclient.collections && viewItem == requestRunning",
          "group": "0_run@1"
        },
        {
          "command": "restclient.runAll",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)(Expanded|Collapsed)?$/",
          "group": "inline@0"
        },
        {
          "command": "restclient.stopRun",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)(Expanded|Collapsed)?Running$/",
          "group": "inline@0"
        },
        {
          "command": "restclient.newRequest",
          "when": "view == restclient.collections && viewItem =~ /^(collection|folder)(Expanded|Collapsed)?(Running)?$/",
          "group": "inline@1"
        },
        {
          "command": "restclient.newFolder",
